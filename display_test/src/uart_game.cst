// uart_game.cst - Pin constraints cho project UART Game Demo

// Clock 50MHz
IO_LOC "clk" T9;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Nút bấm (Active-Low)
IO_LOC "key0" B16;
IO_PORT "key0" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "key1" A15;
IO_PORT "key1" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "key2" C15;
IO_PORT "key2" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// UART
IO_LOC "uart_tx" V8;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

// LED Heartbeat
IO_LOC "led[3]" A9;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

IO_LOC "led[2]" B9;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

IO_LOC "led[1]" C14;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

IO_LOC "led[0]" D14;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
